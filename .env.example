# ---------------------------------------------------------------------------
# Server-only — never prefix with NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# Postgres connection string with PostGIS + pg_trgm (Supabase: Project Settings
# → Database → Connection string → "Transaction pooler", port 6543).
DATABASE_URL=

# Phase 2+ keys (not used in Phase 1). See SETUP.md for how to register.
TMD_UID=
TMD_UKEY=
GISTDA_API_KEY=
FIRMS_MAP_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Public
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the folder holding <layerId>.pmtiles files (e.g. a public Supabase
# Storage bucket). If empty, vector layers are served as MVT from /api/tiles.
NEXT_PUBLIC_PMTILES_BASE_URL=
