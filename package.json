{
  "name": "nakhonsi360",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive environmental map of Nakhon Si Thammarat Province, Thailand",
  "license": "UNLICENSED",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sql": "vitest run --config vitest.sql.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "import:admin": "tsx scripts/import-admin.ts",
    "import:villages": "tsx scripts/import-villages.ts",
    "import:osm": "tsx scripts/import-osm.ts",
    "import:dmr": "tsx scripts/import-dmr.ts",
    "fetch:sources": "tsx scripts/fetch-sources.ts",
    "import:all": "tsx scripts/import-all.ts",
    "build:pmtiles": "bash scripts/build-pmtiles.sh",
    "ingest": "tsx scripts/ingest.ts",
    "refresh:imagery": "tsx scripts/refresh-imagery.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "exifr": "^7.1.3",
    "maplibre-gl": "^6.11.2",
    "next": "^15.5.27",
    "pmtiles": "^4.5.0",
    "postgres": "^3.4.9",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "server-only": "^0.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
